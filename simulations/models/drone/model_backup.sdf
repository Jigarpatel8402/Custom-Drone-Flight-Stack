<?xml version="1.0"?>
<sdf version="1.10">

  <model name="drone">

    <static>false</static>

    <link name="base_link">

      <pose>0 0 0.2 0 0 0</pose>

      <inertial>
        <mass>1.0</mass>

        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.04</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>
      </inertial>

      <collision name="collision">

        <geometry>
          <box>
            <size>0.3 0.3 0.05</size>
          </box>
        </geometry>

      </collision>

      <visual name="visual">

        <geometry>
          <box>
            <size>0.3 0.3 0.05</size>
          </box>
        </geometry>

      </visual>

    </link>

  </model>

</sdf>
