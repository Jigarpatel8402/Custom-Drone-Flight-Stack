<?xml version="1.0"?>
<sdf version="1.10">

  <model name="drone">

    <static>false</static>

    <link name="base_link">

      <pose>0 0 0.2 0 0 0</pose>

      <!-- MASS -->

      <inertial>

        <mass>1.0</mass>

        <inertia>
          <ixx>0.02</ixx>
          <iyy>0.02</iyy>
          <izz>0.04</izz>

          <ixy>0</ixy>
          <ixz>0</ixz>
          <iyz>0</iyz>
        </inertia>

      </inertial>

      <!-- CENTER BODY -->

      <visual name="body_visual">

        <geometry>
          <box>
            <size>0.12 0.12 0.04</size>
          </box>
        </geometry>

      </visual>

      <collision name="body_collision">

        <geometry>
          <box>
            <size>0.12 0.12 0.04</size>
          </box>
        </geometry>

      </collision>

      <!-- FRONT ARM -->

      <visual name="front_arm">

        <pose>0.15 0 0 0 0 0</pose>

        <geometry>
          <box>
            <size>0.30 0.02 0.02</size>
          </box>
        </geometry>

      </visual>

      <!-- REAR ARM -->

      <visual name="rear_arm">

        <pose>-0.15 0 0 0 0 0</pose>

        <geometry>
          <box>
            <size>0.30 0.02 0.02</size>
          </box>
        </geometry>

      </visual>

      <!-- LEFT ARM -->

      <visual name="left_arm">

        <pose>0 0.15 0 0 0 1.5708</pose>

        <geometry>
          <box>
            <size>0.30 0.02 0.02</size>
          </box>
        </geometry>

      </visual>

      <!-- RIGHT ARM -->

      <visual name="right_arm">

        <pose>0 -0.15 0 0 0 1.5708</pose>

        <geometry>
          <box>
            <size>0.30 0.02 0.02</size>
          </box>
        </geometry>

      </visual>

    </link>

  </model>

</sdf>
